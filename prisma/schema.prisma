generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id                  String   @id @default(cuid())
  github_id           String   @unique
  email               String?  @unique
  name                String?
  avatar_url          String?
  github_access_token String?
  created_at          DateTime @default(now())
  repos               Repo[]

  @@map("users")
}

model Repo {
  id                 String   @id @default(cuid())
  user_id            String
  user               User     @relation(fields: [user_id], references: [id])
  github_repo_id     String   @unique
  name               String
  full_name          String
  is_new_repo        Boolean  @default(false)
  connected_at       DateTime @default(now())
  archaeology_done   Boolean  @default(false)
  archaeology_failed Boolean  @default(false)

  decisions          Decision[]
  architecture_files ArchitectureFile[]

  @@map("repos")
}

enum Category {
  database
  infra
  api
  architecture
  tooling
}

enum Source {
  pr
  archaeology
  manual
  questionnaire
}

model Decision {
  id                String                       @id @default(cuid())
  repo_id           String
  repo              Repo                         @relation(fields: [repo_id], references: [id])
  title             String
  rationale         String
  category          Category
  embedding         Unsupported("vector(1536)")?
  pr_url            String?
  confirmed_by_user Boolean                      @default(false)
  source            Source
  created_at        DateTime                     @default(now())

  conflicts Conflict[]

  @@map("decisions")
}

model Conflict {
  id          String   @id @default(cuid())
  decision_id String
  decision    Decision @relation(fields: [decision_id], references: [id])
  pr_url      String?
  pr_title    String?
  description String
  resolved    Boolean  @default(false)
  created_at  DateTime @default(now())

  @@map("conflicts")
}

model ArchitectureFile {
  id           String   @id @default(cuid())
  repo_id      String
  repo         Repo     @relation(fields: [repo_id], references: [id])
  content      String   @db.Text
  committed_at DateTime
  version      Int

  @@map("architecture_files")
}
